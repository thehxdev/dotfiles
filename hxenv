#!/usr/bin/env bash

if ! command -v killall &>/dev/null; then
    function killall() {
        for p in $(pgrep $1); do kill -9 $p; done
    }
fi

export EDITOR='nvim'
export MANPAGER="nvim +Man!"
export GOPROXY="https://goproxy.io,direct"

export __HX_OPT_PATH="$HOME/opt"
export __HX_OPT_GLOBAL_PATH="$__HX_OPT_PATH/_global"

__PATH=""
for p in $(ls -1 $__HX_OPT_GLOBAL_PATH); do
    __absolute_path="$__HX_OPT_GLOBAL_PATH/$p/bin"
    if [[ ! "$PATH" == *"$__absolute_path"* ]]; then
        __PATH+="$__absolute_path:"
    fi
done

__other_paths=(
    "$HOME/.local/bin"
    "$HOME/go/bin"
)
for p in "${__other_paths[@]}"; do
    if [[ ! "$PATH" == *"$p"* ]]; then
        __PATH+="$p:"
    fi
done
export PATH="$PATH:$__PATH"

echo -n "$PATH" > $HOME/.PATH

alias rm='rm -i'
alias nv='nvim'
alias tm='tmux'
alias ll='eza -lh --group-directories-first'
alias la='eza -lha --group-directories-first'
alias ip='ip -c=auto'
alias gitc='git clone --shallow-submodules --remote-submodules --recursive'
alias ec='emacsclient -c -n'
alias ecw='emacsclient -c -nw'

function bs64decode() {
    echo -n "$@" | base64 --decode ; echo
}

# Yazi file manager
function y() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
    yazi "$@" --cwd-file="$tmp"
    IFS= read -r -d '' cwd < "$tmp"
    [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
    rm -f -- "$tmp"
}

function compress-video() {
    ffmpeg -i "$1" -c:v libx264 -crf 30 -preset medium -c:a aac -b:a 128k "C_$1"
}

# FZF
__FZF_WALKER_SKIP=".git,.cache,.var,go,_global,vendor,node_modules,target,build,vcpkg"
export FZF_DEFAULT_OPTS="--tmux 70% --layout reverse"
export FZF_CTRL_T_OPTS="
    --walker=file,dir
    --walker-skip ${__FZF_WALKER_SKIP}
    --preview 'bat -n --color=always {}'
    --bind 'ctrl-/:change-preview-window(down|hidden|)'"
export FZF_ALT_C_OPTS="
    --walker=dir
    --walker-skip ${__FZF_WALKER_SKIP}
    --preview 'eza -T -L 1 {}'"

